# Public values only — safe to copy into js/config.js for GitHub Pages.
# The service-role key must NEVER go in the frontend or this file's committed copy.

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# Set these in the Supabase dashboard → Edge Functions → Secrets (not in git):
# OWNER_PASSWORD_HASH   sha256 hex of the owner password
# VIEWER_PASSWORD_HASH  sha256 hex of the viewer password
# JWT_SECRET            long random string
